# --- Required in production -------------------------------------------------
# Long random string used to sign session cookies.
SESSION_SECRET=

# Neon (or any Postgres) connection string. If unset, an embedded Postgres (PGlite)
# is used and stored in ./.data/pglite, which is fine for local development only.
DATABASE_URL=

# Nimiq JSON-RPC endpoint used to verify payments on-chain (getTransactionByHash).
# See https://nimiq.dev/rpc/open-servers (open servers are for testing, not production).
NIMIQ_RPC_URL=

# Comma-separated Nimiq addresses that become admins on first sign-in.
ADMIN_ADDRESSES=

# --- Local development / demos only ----------------------------------------
# Persona login (fan / artist / admin) without a wallet.
NIMSTAGE_DEMO=0
# Skips on-chain verification for "demo-" transaction hashes. NEVER enable with real money.
NIMSTAGE_DEMO_PAYMENTS=0
# Set to 0 to skip seeding the fictional demo artists.
NIMSTAGE_SEED=1

# --- Media storage ----------------------------------------------------------
# Production on serverless hosts: any S3-compatible bucket (Cloudflare R2 has a free tier).
# When S3_BUCKET is set, audio is stored there instead of local disk.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local disk fallback (development / single-server hosting).
MEDIA_DIR=./.data/media

# --- Deploy tooling (local only, never read by the app) ---
# Render API key, used to create/configure the service from a script: Render dashboard -> Account Settings -> API Keys.
RENDER_API_KEY=

# --- Live video (LiveKit Cloud) ---------------------------------------------
# cloud.livekit.io -> your project -> Settings -> Keys. Without these, "Live video" shows are unavailable.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: where the Earn screen reads the staking pool list (default: Nimiq official mainnet validators API)
# VALIDATORS_API_URL=
# Optional: where the one-luna browser sign-in proof is sent (default: first admin address)
# NIMSTAGE_PROOF_ADDRESS=
